{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dashboard-stats",
  "title": "Dashboard Stats",
  "description": "A dashboard page with KPI stat cards, overview chart placeholder and recent sales list.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "https://nessra-ui.vercel.app/r/button.json",
    "https://nessra-ui.vercel.app/r/card.json",
    "https://nessra-ui.vercel.app/r/stat-card.json"
  ],
  "files": [
    {
      "path": "registry/new-york/blocks/dashboard-stats.tsx",
      "content": "import { Activity, ArrowUpRight, CreditCard, Euro, Users } from \"lucide-react\"\r\n\r\nimport { Button } from \"@/components/ui/button\"\r\nimport {\r\n  Card,\r\n  CardAction,\r\n  CardContent,\r\n  CardDescription,\r\n  CardHeader,\r\n  CardTitle,\r\n} from \"@/components/ui/card\"\r\nimport { StatCard, StatCardGroup } from \"@/components/ui/stat-card\"\r\n\r\nexport function DashboardStats() {\r\n  return (\r\n    <div className=\"bg-background w-full space-y-6 p-6\">\r\n      {/* Stats Grid */}\r\n      <StatCardGroup columns={4}>\r\n        <StatCard\r\n          label=\"Total Revenue\"\r\n          value=\"45 231 €\"\r\n          trend={20}\r\n          trendLabel=\"from last month\"\r\n          icon={<Euro className=\"size-4\" />}\r\n        />\r\n        <StatCard\r\n          label=\"Subscriptions\"\r\n          value=\"+2 350\"\r\n          trend={180}\r\n          trendLabel=\"from last month\"\r\n          icon={<Users className=\"size-4\" />}\r\n        />\r\n        <StatCard\r\n          label=\"Sales\"\r\n          value=\"+12 234\"\r\n          trend={19}\r\n          trendLabel=\"from last month\"\r\n          icon={<CreditCard className=\"size-4\" />}\r\n        />\r\n        <StatCard\r\n          label=\"Active Now\"\r\n          value=\"573\"\r\n          trend={-3}\r\n          trendLabel=\"from last hour\"\r\n          icon={<Activity className=\"size-4\" />}\r\n        />\r\n      </StatCardGroup>\r\n\r\n      {/* Secondary Section */}\r\n      <div className=\"grid gap-6 md:grid-cols-2 lg:grid-cols-7\">\r\n        {/* Overview Card */}\r\n        <Card className=\"lg:col-span-4\">\r\n          <CardHeader>\r\n            <CardTitle>Overview</CardTitle>\r\n            <CardDescription>\r\n              Monthly revenue for the current year\r\n            </CardDescription>\r\n            <CardAction>\r\n              <Button variant=\"ghost\" size=\"sm\">\r\n                View all\r\n                <ArrowUpRight className=\"size-4\" />\r\n              </Button>\r\n            </CardAction>\r\n          </CardHeader>\r\n          <CardContent>\r\n            {/* Placeholder for chart */}\r\n            <div className=\"bg-muted/50 flex h-[300px] items-center justify-center rounded-lg border border-dashed\">\r\n              <p className=\"text-muted-foreground text-sm\">\r\n                Chart component here\r\n              </p>\r\n            </div>\r\n          </CardContent>\r\n        </Card>\r\n\r\n        {/* Recent Sales Card */}\r\n        <Card className=\"lg:col-span-3\">\r\n          <CardHeader>\r\n            <CardTitle>Recent Sales</CardTitle>\r\n            <CardDescription>265 sales this month</CardDescription>\r\n            <CardAction>\r\n              <Button variant=\"ghost\" size=\"sm\">\r\n                View all\r\n                <ArrowUpRight className=\"size-4\" />\r\n              </Button>\r\n            </CardAction>\r\n          </CardHeader>\r\n          <CardContent>\r\n            <div className=\"space-y-4\">\r\n              {recentSales.map((sale) => (\r\n                <div key={sale.email} className=\"flex items-center gap-4\">\r\n                  <div className=\"bg-muted flex size-10 items-center justify-center rounded-full font-medium\">\r\n                    {sale.name\r\n                      .split(\" \")\r\n                      .map((n) => n[0])\r\n                      .join(\"\")}\r\n                  </div>\r\n                  <div className=\"flex-1 space-y-1\">\r\n                    <p className=\"text-sm leading-none font-medium\">\r\n                      {sale.name}\r\n                    </p>\r\n                    <p className=\"text-muted-foreground text-xs\">\r\n                      {sale.email}\r\n                    </p>\r\n                  </div>\r\n                  <div className=\"font-medium\">{sale.amount}</div>\r\n                </div>\r\n              ))}\r\n            </div>\r\n          </CardContent>\r\n        </Card>\r\n      </div>\r\n    </div>\r\n  )\r\n}\r\n\r\nconst recentSales = [\r\n  { name: \"Olivia Martin\", email: \"olivia@example.com\", amount: \"+1 999 €\" },\r\n  { name: \"Jackson Lee\", email: \"jackson@example.com\", amount: \"+39 €\" },\r\n  { name: \"Isabella Nguyen\", email: \"isabella@example.com\", amount: \"+299 €\" },\r\n  { name: \"William Kim\", email: \"william@example.com\", amount: \"+99 €\" },\r\n  { name: \"Sofia Davis\", email: \"sofia@example.com\", amount: \"+39 €\" },\r\n]\r\n",
      "type": "registry:block"
    }
  ],
  "type": "registry:block"
}